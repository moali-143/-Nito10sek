# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GAME_TOKEN_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_SECRET=replace-with-a-different-random-secret

# Canonical site URL; set this to the Vercel production domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
